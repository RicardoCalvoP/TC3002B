/* Un programa para realizar el algoritmo
   de Euclides para calcular mcd. */

int gcd (int u, int v)
{
    if (v == 0) return u;
    else return gcd(v, u - u/v*v);

    /* u - u/v*v == u mod v */
}

void check(void)
{
    int x;
    int y;

    x = input();
    y = input();

    output(gcd(x, y));
}

int x;

int y;

/* textotextotextotextotexto */
int foo(int b) {
    int a;
    a = 10 + b;
    return a;
}

int main(void)
{
    int a[10];
    int w;
    int z;
    w = 90;
    x = foo(w);
    y = w + x;
    z = y + w * x;

    if (x == a[10])
    {
        return 1;
    }
    else
    {
        x = y;
    }

    return 0;
}